{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hazli-ain-engagement",
  "account_id": "9c006d850453ab5c068f5688d138521b",
  "compatibility_date": "2026-11-01",
  // Served at the couple's own domain; Cloudflare creates the DNS record and certificate on deploy.
  "routes": [{ "pattern": "engagement-ain.hazli.dev", "custom_domain": true }],
  // Only the custom domain: no workers.dev address and no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
