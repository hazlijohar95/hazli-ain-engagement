{
  "name": "hazli-ain-engagement",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b && tsc -p convex --noEmit",
    "hoop-glyphs": "node scripts/extract-hoop-glyphs.mjs",
    "og": "vite build --ssr scripts/og.tsx --outDir .og --emptyOutDir && node scripts/render-og.mjs",
    "deploy": "npx convex deploy -y --cmd \"npm run build\" && wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@fontsource/cal-sans": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@web-kits/audio": "^0.2.0",
    "convex": "^1.50.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "opentype.js": "^2.0.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.164.0"
  }
}
